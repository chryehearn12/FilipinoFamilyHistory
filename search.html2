<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Filipino Genealogy Search</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: Arial, sans-serif;
      background: #f7f7f7;
      display: flex;
      min-height: 100vh;
    }

    /* --- Sidebar --- */
    .sidebar {
      width: 220px;
      background: #d32f2f;
      color: white;
      display: flex;
      flex-direction: column;
      padding: 20px;
      position: fixed;
      top: 0;
      bottom: 0;
    }

    .sidebar h2 {
      margin-bottom: 20px;
      font-size: 22px;
    }

    .sidebar a {
      color: white;
      text-decoration: none;
      padding: 10px 0;
      display: block;
      border-radius: 4px;
      transition: background 0.3s;
    }

    .sidebar a:hover {
      background: #b71c1c;
    }

    /* --- Main Content --- */
    .main {
      margin-left: 240px;
      padding: 20px;
      flex: 1;
    }

    h1 {
      margin-bottom: 20px;
    }

    /* --- Search Form --- */
    .search-form {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 20px;
    }

    #searchInput {
      padding: 8px;
      font-size: 16px;
      width: 300px;
      border: 1px solid #ccc;
      border-radius: 4px;
    }

    #searchBtn {
      padding: 8px 12px;
      font-size: 16px;
      border: none;
      background: #d32f2f;
      color: white;
      border-radius: 4px;
      cursor: pointer;
    }

    #searchBtn:hover {
      background: #b71c1c;
    }

    /* --- Table --- */
    table {
      width: 100%;
      border-collapse: collapse;
      display: none; /* hide until search */
      margin-top: 10px;
    }

    th, td {
      padding: 10px;
      border: 1px solid #ddd;
      text-align: left;
    }

    th {
      background: #f2f2f2;
    }

    tr:hover {
      background-color: #f9f9f9;
    }

    #noResults {
      text-align: center;
      margin-top: 10px;
      display: none;
      color: #777;
    }

    /* --- Responsive --- */
    @media (max-width: 768px) {
      .sidebar {
        width: 100%;
        height: auto;
        position: relative;
      }
      .main {
        margin-left: 0;
      }
    }
  </style>
</head>
<body>

  <!-- Sidebar -->
  <div class="sidebar">
    <h2>Genealogy</h2>
    <a href="index.html">Home</a>
    <a href="search.html">Search Records</a>
    <a href="about.html">About</a>
    <a href="contact.html">Contact</a>
    <a href="faq.html">FAQ</a>
  </div>

  <!-- Main Content -->
  <div class="main">
    <h1>Search Records</h1>

    <!-- CSV File Input -->
    <input type="file" id="csvFile" accept=".csv">

    <!-- Search Form -->
    <div class="search-form">
      <input type="text" id="searchInput" placeholder="Search by any field">
      <button id="searchBtn">Search</button>
    </div>

    <!-- Results Table -->
    <table id="resultsTable">
      <thead>
        <tr>
          <th>Given Name</th>
          <th>Surname</th>
          <th>Event</th>
          <th>Year</th>
          <th>Parish</th>
        </tr>
      </thead>
      <tbody></tbody>
    </table>

    <div id="noResults">No results found.</div>
  </div>

  <script>
    let data = [];

    // Load CSV
    document.getElementById('csvFile').addEventListener('change', function(e){
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(e) {
        const text = e.target.result;
        data = parseCSV(text);
        document.getElementById('resultsTable').querySelector('tbody').innerHTML = '';
        document.getElementById('resultsTable').style.display = 'none';
        document.getElementById('noResults').style.display = 'none';
      };
      reader.readAsText(file);
    });

    // Search Function
    document.getElementById('searchBtn').addEventListener('click', function(){
      const query = document.getElementById('searchInput').value.toLowerCase().trim();
      if (!query) {
        document.getElementById('resultsTable').style.display = 'none';
        document.getElementById('noResults').style.display = 'none';
        return;
      }

      const filtered = data.filter(row => 
        Object.values(row).some(val => val.toLowerCase().includes(query))
      );

      renderTable(filtered);
    });

    // CSV Parser
    function parseCSV(text) {
      const lines = text.trim().split('\n');
      const headers = lines[0].split(',').map(h => h.trim().toLowerCase().replace(' ', '_'));
      return lines.slice(1).map(line => {
        const values = line.split(',');
        const obj = {};
        headers.forEach((h,i) => obj[h] = values[i] ? values[i].trim() : '');
        return obj;
      });
    }

    // Render Table
    function renderTable(rows) {
      const tbody = document.getElementById('resultsTable').querySelector('tbody');
      tbody.innerHTML = '';

      if (rows.length === 0) {
        document.getElementById('resultsTable').style.display = 'none';
        document.getElementById('noResults').style.display = 'block';
        return;
      }

      rows.forEach(row => {
        const tr = document.createElement('tr');
        for (const key of ['given_name','surname','event','year','parish']) {
          const td = document.createElement('td');
          td.textContent = row[key] || '';
          tr.appendChild(td);
        }
        tbody.appendChild(tr);
      });

      document.getElementById('resultsTable').style.display = 'table';
      document.getElementById('noResults').style.display = 'none';
    }
  </script>

</body>
</html>
